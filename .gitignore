# Python
build/
dist/
*.egg-info/
.venv/
venv/
*.spec

# Environment / config (may contain secrets or local paths)
.env

# CRITICAL: license signing private key — NEVER commit
.keys/
*.key
*.pem

# License issuance log (may contain user emails / personal info)
admin/licenses_issued.json

# Smoke / debug helpers (often have admin tokens hardcoded)
smoke_*.py
test_*.py
!tests/
!tests/**

# Python bytecode
__pycache__/
*.pyc
*.pyo
tests/**/__pycache__/
tests/**/*.pyc

# Ad-hoc diagnostic / scratch scripts (local-only experiments)
_diag_*.py
_t_*.py
test[0-9]*.py

# Graphify local cache and snapshots
graphify-out/cache/
graphify-out/202*/

# Worker development artifacts
worker/node_modules/
worker/.wrangler/
worker/.dev.vars
.wrangler/

# IDE / OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local state files
*.db
*.db-journal
*.db-shm
*.db-wal
debug_run.log

# Build comparison / experiment artifacts (large, local-only)
build_cmp/
dist_cmp/

# Personal/company signature export used for local testing (contains PII)
signature.html

# Local history snapshots
.history/
